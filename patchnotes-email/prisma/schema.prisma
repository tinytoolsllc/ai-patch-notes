model WatchlistTemplates {
  Id               String                      @id(map: "PK_WatchlistTemplates") @default("", map: "DF__WatchlistT__Id") @db.NVarChar(21)
  Name             String                      @unique(map: "IX_WatchlistTemplates_Name") @db.NVarChar(128)
  Description      String                      @db.NVarChar(512)
  SortOrder        Int
  CreatedAt        DateTime                    @db.DateTimeOffset
