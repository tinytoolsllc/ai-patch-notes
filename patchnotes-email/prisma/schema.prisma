model WatchlistTemplatePackages {
  Id                  String             @id(map: "PK_WatchlistTemplatePackages") @default("", map: "DF__WatchlistTP__Id") @db.NVarChar(21)
  WatchlistTemplateId String             @db.NVarChar(21)
  PackageId           String             @db.NVarChar(21)
  WatchlistTemplates  WatchlistTemplates @relation(fields: [WatchlistTemplateId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_WatchlistTemplatePackages_WatchlistTemplates_WatchlistTemplateId")
  Packages            Packages           @relation(fields: [PackageId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_WatchlistTemplatePackages_Packages_PackageId")

  @@unique([WatchlistTemplateId, PackageId], map: "IX_WatchlistTemplatePackages_WatchlistTemplateId_PackageId")
  @@index([PackageId], map: "IX_WatchlistTemplatePackages_PackageId")
}
